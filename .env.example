# Required for answer generation
OPENROUTER_API_KEY=
MODEL_NAME=openrouter/free

# Optional NCBI metadata; API key is only needed for higher request rates
NCBI_API_KEY=
NCBI_EMAIL=

# Recent-evidence synchronization
AUTO_SYNC_ON_STARTUP=true
EVIDENCE_QUERY=diabetes OR hypertension
SYNC_DAYS=30
SYNC_LIMIT=20

# Use a lightweight CPU reranker for small cloud instances
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
